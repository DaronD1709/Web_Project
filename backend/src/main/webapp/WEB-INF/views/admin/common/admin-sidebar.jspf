<%-- Thanh menu ben trai cua CMS (dung chung moi trang admin). Danh sach muc nam trong admin-nav.jspf. --%>
<div class="drawer-side z-40">
  <label for="adm-drawer" class="drawer-overlay" aria-label="Đóng menu"></label>
  <aside class="w-64 min-h-full bg-neutral text-neutral-content flex flex-col">
    <%-- Logo --%>
    <a href="${ctx}/admin" class="h-14 px-5 flex items-center gap-2 text-lg font-extrabold border-b border-white/10">🌾 Nông Việt
      <span class="badge badge-sm badge-outline border-white/40 text-white/70">CMS</span></a>
    <%-- Danh sach muc menu --%>
    <%@ include file="/WEB-INF/views/admin/common/admin-nav.jspf" %>
    <%-- Chan menu: ve cua hang --%>
    <div class="p-4 border-t border-white/10"><a href="${ctx}/" hx-boost="false" class="btn btn-sm btn-outline btn-block border-white/30 text-neutral-content hover:bg-white/10">← Xem cửa hàng</a></div>
  </aside>
</div>
