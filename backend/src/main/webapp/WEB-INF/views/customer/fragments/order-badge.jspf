<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="badgeClass" value="${order.status == 'PENDING' ? 'badge-warning' : order.status == 'COMPLETED' ? 'badge-success' : order.status == 'RETURN_REQUESTED' ? 'badge-error' : (order.status == 'CANCELLED' or order.status == 'RETURNED') ? 'badge-neutral' : 'badge-info'}" />
<span class="badge ${badgeClass} whitespace-nowrap"><c:out value="${order.status.label}"/></span>
