<%-- Footer dung chung cho moi trang khach hang: gioi thieu + dieu huong + tai khoan + lien he. Nut dieu huong dung btn-ghost (khong dung link tran). --%>
<footer class="site-footer bg-neutral text-neutral-content mt-16">
  <div class="max-w-7xl mx-auto px-4 py-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 text-sm">
    <div>
      <div class="text-lg font-bold mb-2 flex items-center gap-1.5"><i data-lucide="wheat" class="size-5"></i> Nông Việt</div>
      <p class="opacity-70">Hạt giống, phân bón, thuốc BVTV, dụng cụ và máy móc cho nhà nông. Giao tận vườn, đổi trả trong 7 ngày.</p>
      <div class="mt-4 flex flex-wrap gap-2" aria-label="Phương thức thanh toán">
        <span class="badge badge-outline gap-1"><i data-lucide="banknote" class="size-3.5"></i> COD</span>
        <span class="badge badge-outline gap-1"><i data-lucide="credit-card" class="size-3.5"></i> VNPay</span>
      </div>
    </div>
    <nav aria-label="Mua sắm">
      <div class="font-semibold mb-2">Mua sắm</div>
      <div class="flex flex-col items-start gap-1">
        <a href="${ctx}/" class="btn btn-ghost btn-sm px-2 text-neutral-content/80 hover:bg-white/10"><i data-lucide="house" class="size-4"></i> Trang chủ</a>
        <a href="${ctx}/products" class="btn btn-ghost btn-sm px-2 text-neutral-content/80 hover:bg-white/10"><i data-lucide="store" class="size-4"></i> Tất cả sản phẩm</a>
        <a href="${ctx}/cart" class="btn btn-ghost btn-sm px-2 text-neutral-content/80 hover:bg-white/10"><i data-lucide="shopping-cart" class="size-4"></i> Giỏ hàng</a>
      </div>
    </nav>
    <nav aria-label="Tài khoản">
      <div class="font-semibold mb-2">Tài khoản</div>
      <div class="flex flex-col items-start gap-1">
        <a href="${ctx}/orders" class="btn btn-ghost btn-sm px-2 text-neutral-content/80 hover:bg-white/10"><i data-lucide="package" class="size-4"></i> Đơn hàng của tôi</a>
        <a href="${ctx}/notifications" class="btn btn-ghost btn-sm px-2 text-neutral-content/80 hover:bg-white/10"><i data-lucide="bell" class="size-4"></i> Thông báo</a>
        <a href="${ctx}/account/profile" class="btn btn-ghost btn-sm px-2 text-neutral-content/80 hover:bg-white/10"><i data-lucide="user" class="size-4"></i> Hồ sơ cá nhân</a>
      </div>
    </nav>
    <div>
      <div class="font-semibold mb-2">Liên hệ</div>
      <ul class="space-y-2 opacity-80">
        <li class="flex items-start gap-2"><i data-lucide="phone" class="size-4 mt-0.5 shrink-0"></i> 0900 000 000</li>
        <li class="flex items-start gap-2"><i data-lucide="mail" class="size-4 mt-0.5 shrink-0"></i> support@nongviet.vn</li>
        <li class="flex items-start gap-2"><i data-lucide="map-pin" class="size-4 mt-0.5 shrink-0"></i> 123 Đường Nông Nghiệp, TP. Hồ Chí Minh</li>
        <li class="flex items-start gap-2"><i data-lucide="clock" class="size-4 mt-0.5 shrink-0"></i> Thứ 2 – Thứ 7, 8:00 – 17:30</li>
      </ul>
      <a href="${ctx}/chat" class="btn btn-outline btn-sm mt-3 border-white/30 text-neutral-content hover:bg-white/10"><i data-lucide="message-circle" class="size-4"></i> Chat với shop</a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-4 text-xs opacity-60 flex flex-wrap items-center justify-between gap-2">
      <span>© 2026 Nông Việt — đồ án môn học</span>
      <span>Thanh toán thử nghiệm qua VNPay sandbox</span>
    </div>
  </div>
</footer>
<%-- Toast: server bao qua header HX-Trigger {"showToast":{"message":..,"type":"success|error"}} (xem util/HtmxUtil) --%>
<div id="toast-box" class="toast toast-end toast-bottom z-50"></div>
<script>
  document.body.addEventListener('showToast', function (e) {
    var d = e.detail || {}, el = document.createElement('div');
    el.className = 'alert shadow-lg text-sm ' + (d.type === 'error' ? 'alert-error' : 'alert-success');
    el.textContent = d.message;
    document.getElementById('toast-box').appendChild(el);
    setTimeout(function () { el.remove(); }, 3000);
  });
</script>

<%-- ===== BONG BONG CHAT (goc phai moi trang khach) =====
     Bam bong bong -> mo khung chat nho ngay tren trang dang xem, khong phai chuyen sang /chat. Chi hien voi khach (chua dang nhap hoac Customer),
     khong hien voi Admin va khong hien tren chinh trang /chat (trang do dat hideChatWidget).
     Cach hoat dong (htmx, khong WebSocket, dung lai ChatServlet/ChatService nhu trang /chat):
       1. Bam bong bong -> htmx.ajax GET /chat/widget, ket qua (cac tin nhan + o nhap, hoac o nhap ten cho khach vang lai) nhet vao #nvw-body.
       2. Khung tin nhan tu hoi /chat/messages moi 3 giay (the #poll trong fragment chat-messages.jsp) CHI khi khung dang mo.
       3. Dong khung thi xoa #nvw-body de ngung polling; mo lai se nap lai toan bo tin tu server (tin luu trong DB nen khong mat).
     Trang thai mo/dong duoc nho bang sessionStorage de khung van mo khi khach chuyen trang. --%>
<c:if test="${(empty sessionScope.currentUser or sessionScope.currentUser.customer) and empty hideChatWidget}">
  <%-- ----- Khung chat (an mac dinh; them lop is-open de hien). Kich thuoc va vi tri o design.css (.nv-chatbox) ----- --%>
  <section id="nvw-box" class="nv-chatbox card bg-base-100 border border-base-300 shadow-2xl" role="dialog" aria-label="Chat với shop">
    <%-- Dau khung: tieu de + nut mo trang chat day du + nut dong --%>
    <div class="flex items-center gap-2 px-4 py-3 bg-primary text-primary-content">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle-more size-5" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/></svg>
      <div class="flex-1 min-w-0"><div class="font-semibold leading-tight">Chat với shop</div><div class="text-xs opacity-80">Nhân viên phản hồi trong giờ làm việc</div></div>
      <a href="${ctx}/chat" class="btn btn-ghost btn-xs btn-circle" aria-label="Mở trang chat đầy đủ" title="Mở rộng"><i data-lucide="maximize-2" class="size-4"></i></a>
      <button type="button" id="nvw-close" class="btn btn-ghost btn-xs btn-circle" aria-label="Đóng khung chat"><i data-lucide="x" class="size-4"></i></button>
    </div>
    <%-- Than khung: noi dung do server tra ve (fragments/chat-widget.jsp), de trong cho den khi khach mo --%>
    <div id="nvw-body" class="nv-chatbox-body"></div>
  </section>

  <%-- ----- Nut bong bong tron o goc phai duoi ----- --%>
  <button type="button" id="nvw-fab" class="nv-chatfab btn btn-primary btn-circle shadow-xl" data-url="${ctx}/chat/widget"
          aria-label="Chat với shop" aria-expanded="false" aria-controls="nvw-box"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle-more size-7" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/></svg></button>

  <script>
    (function () {
      var fab = document.getElementById('nvw-fab'), box = document.getElementById('nvw-box'), body = document.getElementById('nvw-body');
      if (!fab || !box || !body) return;
      var KEY = 'nvChatOpen', shown = 0; // shown = so bong bong da hien, de chi cuon xuong khi co tin MOI

      // sessionStorage co the bi chan (che do rieng tu...) -> boc try/catch, khong nho duoc thi thoi
      function remember(open) { try { sessionStorage.setItem(KEY, open ? '1' : '0'); } catch (e) { } }

      function openChat() {
        box.classList.add('is-open');
        fab.setAttribute('aria-expanded', 'true');
        remember(true);
        shown = 0;
        // Nap noi dung khung chat tu server vao #nvw-body (header HX-Target = nvw-body de ChatServlet biet day la yeu cau cua bong bong)
        htmx.ajax('GET', fab.getAttribute('data-url'), { target: '#nvw-body', swap: 'innerHTML' });
      }

      function closeChat() {
        box.classList.remove('is-open');
        fab.setAttribute('aria-expanded', 'false');
        remember(false);
        body.innerHTML = ''; // go noi dung -> the #poll bien mat -> htmx ngung hoi server
      }

      fab.addEventListener('click', function () { box.classList.contains('is-open') ? closeChat() : openChat(); });
      document.getElementById('nvw-close').addEventListener('click', closeChat);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && box.classList.contains('is-open')) closeChat(); });

      // Co tin moi (hoac vua nap khung) thi cuon khung tin xuong cuoi; khong co tin moi thi giu nguyen de khach doc tin cu
      document.body.addEventListener('htmx:afterSwap', function () {
        var msgs = document.getElementById('nvw-msgs');
        if (!msgs) return;
        var n = msgs.querySelectorAll('.chat').length;
        if (n !== shown) { shown = n; msgs.scrollTop = msgs.scrollHeight; }
      });

      try { if (sessionStorage.getItem(KEY) === '1') openChat(); } catch (e) { }
    })();
  </script>
</c:if>
