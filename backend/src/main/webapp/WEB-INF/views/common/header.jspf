<%-- Header dung chung (chuyen tu mockup/layout.js). Can head.jspf da duoc include truoc (dinh nghia ${ctx}). --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header class="bg-base-100 border-b border-base-300 sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center gap-3">
    <a href="${ctx}/" class="text-lg sm:text-xl font-extrabold text-primary whitespace-nowrap">🌾 NôngViệt</a>

    <form action="${ctx}/products" method="get" class="hidden sm:block flex-1 max-w-xl mx-auto">
      <label class="input w-full">
        <input type="search" name="q" value="<c:out value='${filter.keyword}'/>" placeholder="Tìm hạt giống, phân bón, máy móc…" />
      </label>
    </form>

    <div class="flex items-center gap-2 ml-auto sm:ml-0">
      <a href="${ctx}/chat" class="btn btn-ghost btn-sm" aria-label="Chat với shop"><span aria-hidden="true">💬</span><span class="hidden sm:inline">Chat</span></a>
      <a href="${ctx}/cart" class="btn btn-ghost btn-sm" aria-label="Giỏ hàng">
        <span class="indicator"><span aria-hidden="true">🛒</span><jsp:include page="/WEB-INF/views/customer/fragments/cart-count.jsp" /></span>
        <span class="hidden sm:inline">Giỏ hàng</span></a>
      <c:choose>
        <c:when test="${not empty sessionScope.currentUser}">
          <c:choose>
            <c:when test="${sessionScope.currentUser['class'].simpleName eq 'Customer'}">
              <jsp:include page="/WEB-INF/views/common/customer-account-menu.jsp" />
            </c:when>
            <c:otherwise>
              <span class="text-sm hidden md:inline-block max-w-32 lg:max-w-48 truncate"><c:out value="${sessionScope.currentUser.fullName}"/></span>
              <form action="${ctx}/logout" method="post" class="inline"><button class="btn btn-ghost btn-sm text-error">Đăng xuất</button></form>
            </c:otherwise>
          </c:choose>
        </c:when>
        <c:otherwise>
          <a href="${ctx}/login" class="btn btn-ghost btn-sm">Đăng nhập</a>
          <a href="${ctx}/register" class="btn btn-primary btn-sm">Đăng ký</a>
        </c:otherwise>
      </c:choose>
    </div>
  </div>
</header>
