# Copy file nay thanh "mail.properties" (cung thu muc) roi dien thong tin SMTP cua BAN.
# mail.properties da nam trong .gitignore - KHONG commit mat khau len repo (repo public).
#
# mail.enabled=false (hoac khong co file) -> app KHONG gui that, chi in noi dung email ra log Tomcat.
mail.enabled=false

# --- Vi du Gmail ---
# Bat xac thuc 2 buoc cho tai khoan Google, tao "Mat khau ung dung" (App password) tai
# https://myaccount.google.com/apppasswords roi dan vao mail.password (KHONG dung mat khau Gmail that).
mail.host=smtp.gmail.com
mail.port=587
mail.auth=true
mail.starttls=true
mail.username=email_cua_ban@gmail.com
mail.password=mat_khau_ung_dung_16_ky_tu
mail.from=email_cua_ban@gmail.com

# --- Khong co SMTP that? Chay may chu SMTP gia lap tren may (xem README) roi dung: ---
# mail.host=localhost
# mail.port=1025
# mail.auth=false
# mail.starttls=false

# Dia chi goc cua web, dung de tao link trong email (vd: link dat lai mat khau). Bo trong = lay tu request.
app.base.url=http://localhost:8080/ecommerce
